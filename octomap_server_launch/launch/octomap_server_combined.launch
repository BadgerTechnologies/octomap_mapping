<launch>
  <arg name="debug" default="false" />
  <arg name="profile" default="false" />
  <arg name="launch_prefix_debug" default="gdb -ex run --args" />
  <arg name="launch_prefix_profile" default="/usr/bin/env LD_PRELOAD=/usr/lib/libprofiler.so.0 CPUPROFILE=/tmp/prof.out CPUPROFILESIGNAL=12" />
  <arg name="launch_prefix" default="$(eval arg('launch_prefix_debug') if arg('debug') else arg('launch_prefix_profile') if arg('profile') else '')" />
  <env name="ROSCONSOLE_FORMAT" value='[${severity}] [${time}]: ${node}: ${message}' />
  <group ns="octomap">
    <!-- Front lidar -->
    <group if="$(optparam /hardware/sensors/lidars/front/present False)">
      <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
        <arg name="sensor_name" value="front_lidar" />
        <arg name="launch_prefix" value="$(arg launch_prefix)" />
        <arg name="frame_id" value="odom" />
      </include>
      <group ns="map" if="$(optenv ENABLE_COSTMAP_3D_GLOBAL False)">
        <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
          <arg name="sensor_name" value="front_lidar_map" />
          <arg name="launch_prefix" value="$(arg launch_prefix)" />
          <arg name="frame_id" value="map" />
        </include>
      </group>
    </group>
    <!-- Proximity cameras. It is OK for all proximity cameras to cross-clear. -->
    <group if="$(eval optparam('/hardware/sensors/cameras/depth/proximity_front/present', 'false').lower() == 'true' or
                      optparam('/hardware/sensors/cameras/depth/proximity_front2/present', 'false').lower() == 'true' or
                      optparam('/hardware/sensors/cameras/depth/proximity_back/present', 'false').lower() == 'true' or
                      optparam('/hardware/sensors/cameras/depth/proximity_back2/present', 'false').lower() == 'true')">
      <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
        <arg name="sensor_name" value="proximity" />
        <arg name="launch_prefix" value="$(arg launch_prefix)" />
        <arg name="frame_id" value="odom" />
      </include>
      <group ns="map" if="$(optenv ENABLE_COSTMAP_3D_GLOBAL False)">
        <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
          <arg name="sensor_name" value="proximity_map" />
          <arg name="launch_prefix" value="$(arg launch_prefix)" />
          <arg name="frame_id" value="map" />
        </include>
      </group>
    </group>
    <!-- Top lidar -->
    <group if="$(optparam /hardware/sensors/lidars/top_hat/present False)">
      <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
        <arg name="sensor_name" value="top_lidar" />
        <arg name="launch_prefix" value="$(arg launch_prefix)" />
        <arg name="frame_id" value="odom" />
      </include>
      <group ns="map" if="$(optenv ENABLE_COSTMAP_3D_GLOBAL False)">
        <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
          <arg name="sensor_name" value="top_lidar_map" />
          <arg name="launch_prefix" value="$(arg launch_prefix)" />
          <arg name="frame_id" value="map" />
        </include>
      </group>
    </group>
    <!-- Top front lidar -->
    <group if="$(optparam /hardware/sensors/lidars/top_front/present False)">
      <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
        <arg name="sensor_name" value="top_front_lidar" />
        <arg name="launch_prefix" value="$(arg launch_prefix)" />
        <arg name="frame_id" value="odom" />
      </include>
      <group ns="map" if="$(optenv ENABLE_COSTMAP_3D_GLOBAL False)">
        <include file="$(find octomap_server_launch)/launch/octomap_server_sensor.launch">
          <arg name="sensor_name" value="top_front_lidar_map" />
          <arg name="launch_prefix" value="$(arg launch_prefix)" />
          <arg name="frame_id" value="map" />
        </include>
      </group>
    </group>
    <rosparam file="$(env BAR_CONFIG)/octomap_server_sensor_overrides.yaml" command="load" />
  </group>
</launch>
